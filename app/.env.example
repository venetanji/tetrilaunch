# Copy to .env (gitignored) before building the native apps.
#
# RevenueCat *public* SDK keys — Project settings → API keys → "App specific
# keys" in the RevenueCat dashboard. These are publishable and end up in the
# client bundle by design; the secret keys are the ones that stay server-side.
#
# Keep the values here as PLACEHOLDERS. This file is committed, so a real key
# pasted in travels to every fork — which is the exact coupling the env
# indirection exists to prevent (see the comment in src/lib/purchases.ts).
#
# Without them the app still builds and runs, the store UI just hides itself.
VITE_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Social sign-in (src/lib/auth.ts) — OAuth client IDENTIFIERS, public by
# design; the matching secrets never exist client-side (docs/AUTH.md).
# Google web client id: used by the web build AND Android's Credential Manager.
VITE_GOOGLE_WEB_CLIENT_ID=xxxxxxxx-xxxxxxxx.apps.googleusercontent.com
# Google iOS client id: the native iOS Google flow only.
VITE_GOOGLE_IOS_CLIENT_ID=xxxxxxxx-xxxxxxxx.apps.googleusercontent.com
# Apple Services ID: the web Sign in with Apple popup only — native iOS signs
# in against the app's own bundle id and needs no id here.
VITE_APPLE_WEB_CLIENT_ID=com.example.services-id

# RevenueCat Test Store — simulated purchases with no Play/App Store product
# setup, for testing before a developer account exists. Used ONLY by
# `npm run android:apk:test` (--mode teststore); every other build ignores it,
# and verify:store fails if it reaches a shippable bundle. See docs/NATIVE.md.
VITE_REVENUECAT_TEST_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
